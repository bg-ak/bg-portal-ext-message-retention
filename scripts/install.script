try { if '$system.CLS.IsMthd("%IPM.Main","Shell") { throw ##class(%Exception.General).%New("The Docker helper requires IPM 0.10.9 enabled in this Portal namespace; see README for manual ZPM installation") } if $parameter("Portal.Ext.Registry","APIVERSION")'=2 { throw ##class(%Exception.General).%New("Requires Portal extension API 2") } set sc=##class(%IPM.Main).Shell("load "_$system.Util.GetEnviron("BG_RETENTION_PACKAGE")) if $system.Status.IsError(sc) { do $system.Status.DisplayError(sc) } else { write !,"RETENTION INSTALL PASSED",! } } catch ex { write !,$system.Status.GetErrorText(ex.AsStatus()),! }
halt
